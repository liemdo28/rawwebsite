---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime()
);
---

<BaseLayout
  title="Blog | Raw Sushi Bar"
  description="Explore sushi tips, restaurant news, local dining guides, and behind-the-scenes insights from Raw Sushi Bar in Stockton and Modesto, CA."
>
  <main id="main-content">
    <section class="blog-hero">
      <div class="container">
        <span class="blog-hero-badge">Since 2005</span>
        <h1>Fresh Sushi Stories</h1>
        <p>Dining guides, seasonal specials, and local discoveries from Raw Sushi Bar, Stockton & Modesto, CA.</p>
      </div>
    </section>

    <section class="blog-listing">
      <div class="container">
        {posts.length === 0 ? (
          <p class="blog-empty">No posts yet — check back soon.</p>
        ) : (
          <div class="blog-grid">
            {posts.map(post => (
              <a href={`/blog/${post.id}/`} class="blog-card">
                <div class="blog-image">
                  {post.data.image ? (
                    <img src={post.data.image} alt={post.data.title} loading="lazy" />
                  ) : (
                    <div class="blog-image-placeholder">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                      </svg>
                    </div>
                  )}
                </div>
                <div class="blog-card-content">
                  <span class="blog-card-badge" style={`background: ${post.data.categoryColor || '#C41E3A'};`}>
                    {post.data.category || 'Dining Guide'}
                  </span>
                  <h2 class="blog-card-title">{post.data.title}</h2>
                  <p class="blog-card-desc">{post.data.description}</p>
                  <div class="blog-card-meta">
                    <time datetime={new Date(post.data.datePublished).toISOString()}>
                      {post.data.datePublished}
                    </time>
                    <span class="blog-card-sep">|</span>
                    <span>{post.data.readTime || '5 min read'}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .blog-hero {
    background: linear-gradient(135deg, #1a1a1a 0%, #2b2b2b 100%);
    color: #fff;
    padding: 8rem 2rem 5rem;
    text-align: center;
  }

  .blog-hero-badge {
    display: inline-block;
    background: linear-gradient(135deg, #d4af37 0%, #c9a227 100%);
    color: #1a1a1a;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .blog-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    margin-bottom: 1rem;
    color: #fff;
    line-height: 1.1;
  }

  .blog-hero p {
    font-size: 1.1rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .blog-listing {
    padding: 4rem 2rem;
    background: #faf8f5;
  }

  .blog-empty {
    text-align: center;
    color: #8a847e;
    font-size: 1.1rem;
    padding: 4rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .blog-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    display: block;
  }

  .blog-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    text-decoration: none;
  }

  .blog-image {
    height: 200px;
    overflow: hidden;
    background: #f5f0ea;
  }

  .blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card:hover .blog-image img {
    transform: scale(1.05);
  }

  .blog-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d4af37;
  }

  .blog-image-placeholder svg {
    width: 48px;
    height: 48px;
  }

  .blog-card-content {
    padding: 1.5rem;
  }

  .blog-card-badge {
    display: inline-block;
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .blog-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: #2c2824;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .blog-card-desc {
    font-size: 0.9rem;
    color: #5a544e;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .blog-card-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #8a847e;
    align-items: center;
  }

  .blog-card-sep {
    opacity: 0.4;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .blog-hero {
      padding: 6rem 1.5rem 3rem;
    }

    .blog-hero h1 {
      font-size: 2.2rem;
    }

    .blog-listing {
      padding: 3rem 1.5rem;
    }
  }
</style>
