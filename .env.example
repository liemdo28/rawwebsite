# ─── Agent-coding bridge ─────────────────────────────────────────────
# Base URL of the Agent-coding service. Used to push job results back.
AGENT_CODING_API_BASE_URL=https://agent.example.com/api/v1

# Shared secret (HMAC) used for outbound calls to Agent-coding.
AGENT_CODING_API_KEY=replace-me-with-a-long-random-string

# Webhook secret for inbound POST /api/agent/webhook (HMAC-SHA256 over body).
AGENT_CODING_WEBHOOK_SECRET=replace-me-with-a-long-random-string

# ─── Admin CMS auth ─────────────────────────────────────────────────
# Shared secret for admin CMS (Bearer token in Authorization header).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAWWEBSITE_ADMIN_SECRET=replace-me-with-a-long-random-string

# Path to the on-disk JSON store. Default: ./data
RAWWEBSITE_DATA_DIR=./data
